{
  "name": "painel-labcidades",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:api": "node server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "start": "SERVE_STATIC=1 node server/index.mjs",
